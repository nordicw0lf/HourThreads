    <string name="privacy_policy">Privacy policy</string>
    <string name="privacy_updated">Last updated %1$s</string>
    <string name="privacy_intro">HourThreads is a completely free and open-source Android app. This policy explains how it handles your information.</string>
    <string name="privacy_local_title">Information stored on your device</string>
    <string name="privacy_local_body">HourThreads saves the jobs, shifts, notes, pay details, and preferences you choose to enter in app storage on your device. It uses these records locally to track work hours, calculate pay estimates, and remember your settings.</string>
    <string name="privacy_tracking_title">Tracking and data transmission</string>
    <string name="privacy_tracking_body">HourThreads contains no tracking technologies. It uses no analytics, advertising trackers, or remote crash reporting. It works offline, requires no account, and sends no information about you, your device, or your app use to the developer or to any server.</string>
    <string name="privacy_backups_title">Backups you choose to export</string>
    <string name="privacy_backups_body">When you export a backup, HourThreads writes a readable JSON copy to the location you select in Android. If you choose cloud storage or share the file, that provider or recipient handles the copy. HourThreads reads a backup only when you select it for import.</string>
    <string name="privacy_control_title">Managing and deleting your data</string>
    <string name="privacy_control_body">You can review, edit, or delete shifts in the Log. To remove all data held by HourThreads on this device, clear its app storage in Android Settings or uninstall the app. You can delete exported backup files separately from the locations where you saved them.</string>
